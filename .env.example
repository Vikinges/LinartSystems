# Default host port for the Hub container. Keep 8080 unless it's occupied on the host.
HUB_PORT=8080

# HTTPS certificate email for Let's Encrypt challenges.
LETSENCRYPT_EMAIL=admin@example.com

# Hub secrets
SESSION_SECRET=change_me_session_secret
HUB_ADMIN_PASSWORD=change_me_hub_admin_password

# Service2 admin password (PDF service). Used to seed /app/data/admin.json at start.
ADMIN_PASSWORD=change_me_service2_admin_password

# Default host port for the Hub container. Keep 8080 unless it's occupied on the host.
HUB_PORT=8080

# Hub secrets
SESSION_SECRET=change_me_session_secret
HUB_ADMIN_PASSWORD=change_me_hub_admin_password

# Service2 admin password (PDF service). Used to seed /app/data/admin.json at start.
ADMIN_PASSWORD=change_me_service2_admin_password

# Optional: PaddleOCR HTTP endpoint (for better sticker/label OCR). Leave empty to disable.
PADDLE_OCR_URL=http://paddle-ocr:8866/predict/ocr_system

# Signing service integration
SIGN_INTERNAL_TOKEN=change_me_sign_internal_token
SIGN_SERVICE_URL=http://service-sign:3002
PUBLIC_SIGN_BASE_URL=https://lsc-led.de/sign

# APNs push (P3). Leave empty to keep push disabled (registry still works).
# APNS_KEY_P8_BASE64 = base64 of the .p8 auth key file (single line, no newlines).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_ENV=production
APNS_KEY_P8_BASE64=
